{
  "name": "skillmatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "auth:test:local": "node scripts/test-auth-local.mjs",
    "auth:test:onboarding:local": "node scripts/test-auth-onboarding-local.mjs",
    "missions:test:local": "node scripts/test-missions-local.mjs",
    "applications:test:local": "node scripts/test-applications-local.mjs",
    "matches:test:local": "node scripts/test-matches-local.mjs",
    "messages:test:local": "node scripts/test-messaging-local.mjs",
    "reviews:test:local": "node scripts/test-reviews-dashboard-local.mjs",
    "moderation:test:local": "node scripts/test-moderation-local.mjs",
    "db:start": "supabase db start",
    "local:start": "node scripts/start-local-stack.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning",
    "db:test": "supabase test db",
    "db:test:concurrency": "node scripts/test-db-acceptance-concurrency.mjs",
    "db:smoke": "supabase db query --local --file supabase/verification/schema_smoke.sql && supabase db query --local --file supabase/verification/constraints_smoke.sql",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.generated.ts && prettier --write src/types/database.generated.ts",
    "db:verify": "supabase db start && npm run db:reset && npm run db:lint && npm run db:smoke && npm run db:test && npm run db:test:concurrency && npm run db:types",
    "build": "tsc -b --pretty false && vite build",
    "deployment:check": "node scripts/verify-deployment-config.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run deployment:check",
    "verify:full": "node scripts/verify-full.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
